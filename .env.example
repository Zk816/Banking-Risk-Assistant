# Copy to .env and adjust. Never commit .env.

# --- Database ---
# Matches docker-compose.yml. Port 5435 because 5432-5434 are used by other projects.
DATABASE_URL=postgresql://kzbank:kzbank@localhost:5435/kzbank

# --- Embeddings ---
# bge-m3 is multilingual (Russian, Kazakh, English) and already in ~/.cache/huggingface.
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# "cuda:0" means "the first GPU that is visible to this process", NOT physical GPU 0.
# Choose the physical GPU outside the app:  CUDA_VISIBLE_DEVICES=3 uv run ...
# Use "cpu" if no GPU is free — bge-m3 on CPU is slow but works.
EMBED_DEVICE=cuda:0
EMBED_BATCH_SIZE=8

# --- Generation ---
# Local ollama speaking the OpenAI-compatible protocol. No API key, no cost.
LLM_BASE_URL=http://localhost:8310/v1
LLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
LLM_TIMEOUT_S=120

# --- Retrieval ---
# Step 1 uses deliberately naive fixed-size chunking. Step 2 replaces it.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Rough guard on how much retrieved text we hand the model.
MAX_CONTEXT_CHARS=12000

# --- Paths ---
RAW_DATA_DIR=data/raw

# --- Logging ---
# Hard ceiling on disk: LOG_MAX_MB * (LOG_BACKUP_COUNT + 1). Default 100 MB.
# LOG_MAX_MB=0 would disable rotation entirely — config refuses it.
LOG_LEVEL=INFO
LOG_MAX_MB=20
LOG_BACKUP_COUNT=4

# --- API (Phase 2) ---
API_HOST=127.0.0.1
API_PORT=8020
